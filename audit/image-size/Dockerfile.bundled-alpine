# syntax=docker/dockerfile:1

# keep in sync with "packageManager" in package.json
# see all versions at https://hub.docker.com/r/oven/bun/tags
ARG BUN_VERSION=1.4.2

FROM oven/bun:${BUN_VERSION}-alpine AS base
WORKDIR /usr/src/app

# install all dependencies, including devDependencies
# this layer is cached until package.json or bun.lock change
FROM base AS deps
COPY package.json bun.lock bunfig.toml ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# install with --production (exclude devDependencies)
FROM base AS prod-deps
COPY package.json bun.lock bunfig.toml ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --omit=peer

# copy all (non-ignored) project files, then typecheck and test them
# the release stage copies from here, so a failing check fails the build
FROM deps AS verify
COPY . .
RUN bun run typecheck && bun test

# Build only the executable JavaScript dependency graph.
FROM verify AS bundled
RUN mkdir -p /out/app /out/migrations && \
    bun build --target=bun --minify src/index.ts --outfile=/out/app/server.js && \
    bun build --target=bun --minify src/db/backup.ts --outfile=/out/app/backup.js && \
    cp -R src/db/migrations/. /out/migrations/ && \
    printf '%s\n' '{"type":"module","scripts":{"db:backup":"bun app/backup.js"}}' > /out/package.json

FROM oven/bun:${BUN_VERSION}-alpine AS release
WORKDIR /usr/src/app
ENV NODE_ENV=production DATA_DIR=/data
COPY --from=bundled /out/ ./
RUN ["bun", "-e", "require('node:fs').mkdirSync('/data'); require('node:fs').chownSync('/data', 1000, 1000)"]
VOLUME /data
USER 1000:1000
EXPOSE 3000/tcp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["bun", "-e", "const res = await fetch(`http://127.0.0.1:${process.env.APP_PORT || 3000}/health`); process.exit(res.ok ? 0 : 1);"]
ENTRYPOINT ["bun", "app/server.js"]
