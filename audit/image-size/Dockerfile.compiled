# syntax=docker/dockerfile:1

# keep in sync with "packageManager" in package.json
# see all versions at https://hub.docker.com/r/oven/bun/tags
ARG BUN_VERSION=1.4.2

FROM oven/bun:${BUN_VERSION}-slim AS base
WORKDIR /usr/src/app

# install all dependencies, including devDependencies
# this layer is cached until package.json or bun.lock change
FROM base AS deps
COPY package.json bun.lock bunfig.toml ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# install with --production (exclude devDependencies)
FROM base AS prod-deps
COPY package.json bun.lock bunfig.toml ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production

# copy all (non-ignored) project files, then typecheck and test them
# the release stage copies from here, so a failing check fails the build
FROM deps AS verify
COPY . .
RUN bun run typecheck && bun test

FROM verify AS compiled
# For this experiment, filesystem migrations resolve from the container working directory.
RUN sed -i 's@join(import.meta.dir, "../migrations")@join(process.cwd(), "migrations")@' src/db/init/migrate.ts
RUN printf '%s\n' \
    'if (Bun.argv[2] === "health") {' \
    '  const response = await fetch(`http://127.0.0.1:${process.env.APP_PORT || 3000}/health`);' \
    '  process.exit(response.ok ? 0 : 1);' \
    '} else if (Bun.argv[2] === "backup") {' \
    '  const { backup } = await import("./src/db/backup");' \
    '  console.log(`Wrote ${backup(Bun.argv[3])}`);' \
    '} else {' \
    '  await import("./src/index");' \
    '}' > standalone.ts
RUN mkdir -p /out/data && chown 1000:1000 /out/data && \
    bun build --compile --target=bun-linux-x64-baseline --minify standalone.ts --outfile=/out/server

FROM gcr.io/distroless/base-nossl-debian13 AS release
WORKDIR /usr/src/app
ENV NODE_ENV=production DATA_DIR=/data
COPY --from=compiled /out/server /usr/local/bin/server
COPY --from=compiled /out/data /data
COPY --from=verify /usr/src/app/src/db/migrations migrations
VOLUME /data
USER 1000:1000
EXPOSE 3000/tcp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["server", "health"]
ENTRYPOINT ["server"]
