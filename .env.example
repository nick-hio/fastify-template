# Copy to `.env` for local development; Bun loads it automatically.
# Every variable is optional. See the README for defaults and descriptions.

NODE_ENV="development"
LOG_LEVEL="debug"

APP_HOST="0.0.0.0"
APP_PORT="3000"

DATA_DIR="./data"

TRUST_PROXY="false"

REQUEST_TIMEOUT_MS="30000"
SHUTDOWN_TIMEOUT_MS="8000"

# Docker Compose only: the user the container runs as, as "uid:gid". It must own DATA_DIR.
CONTAINER_USER="1000:1000"
